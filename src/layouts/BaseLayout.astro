---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/global.css';
interface Props { title: string; description: string; theme?: string; }
const { title, description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.tx0521.org');
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="icon" href="/images/favicon.png" /><title>{title} | Troop TX-0521</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:title" content={`${title} | Troop TX-0521`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /></head><body class={theme}><Header /><main><slot /></main><Footer /></body></html>
