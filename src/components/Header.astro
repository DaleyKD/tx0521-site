---
import Navigation from './Navigation.astro';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Troop TX-0521 home"><img src="/images/logo.png" alt="Troop TX-0521" width="392" height="120" /><img class="brand-mobile" src="/images/mobile-logo.png" alt="" width="160" height="160" /></a>
    <button class="menu-button" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><span class="sr-only">Open navigation</span></button>
    <div class="header-nav-group">
      <Navigation />
      <div class="header-social">
        <a href="https://www.facebook.com/tx0521" target="_blank" rel="noreferrer" aria-label="Troop TX-0521 on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href="https://www.facebook.com/groups/tx0521members" target="_blank" rel="noreferrer" aria-label="Troop TX-0521 Facebook Group">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('.primary-nav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    button.setAttribute('aria-expanded', String(open));
  });
</script>
