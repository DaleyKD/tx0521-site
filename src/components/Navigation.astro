---
import { navigation, type NavItem } from '../data/navigation';
import NavList from './NavList.astro';

const path = Astro.url.pathname;
// Exact match only — a parent like "About" should not light up just because a
// descendant page (e.g. Join Our Troop) is the one actually being viewed.
const isActive = (href?: string) => !!href && href === path;

function linkProps(item: NavItem): Record<string, string> {
  return item.newTab ? { target: '_blank', rel: 'noreferrer' } : {};
}
---
<nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
  <NavList items={navigation} depth={0} isActive={isActive} linkProps={linkProps} />
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.primary-nav');

  function toggleSubmenu(button: HTMLButtonElement) {
    const parent = button.closest('li.has-menu');
    const open = parent?.classList.toggle('expanded');
    button.setAttribute('aria-expanded', String(open));

    // A collapse/expand reflows the menu (items above shift up or down).
    // Briefly ignore taps on the rest of the nav so a tap that lands right
    // as that happens can't hit whatever item just moved into its place.
    if (nav) {
      nav.style.pointerEvents = 'none';
      window.setTimeout(() => {
        nav.style.pointerEvents = '';
      }, 260);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.submenu-button').forEach((button) => {
    button.addEventListener('click', () => toggleSubmenu(button));
  });

  // A group label with no destination of its own (e.g. "Programs", "Links")
  // — make the whole row a tap target, not just the small chevron.
  document.querySelectorAll<HTMLElement>('.menu-row-no-link').forEach((row) => {
    row.addEventListener('click', (e) => {
      if ((e.target as Element).closest('.submenu-button')) return; // avoid double-toggling
      const button = row.querySelector<HTMLButtonElement>('.submenu-button');
      if (button) toggleSubmenu(button);
    });
  });
</script>
